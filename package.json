{
  "name": "@thetekteam/agent-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.0"
  },
  "scripts": {
    "import:modelspend": "node scripts/import-modelspend-runner.mjs --write",
    "validate:import": "node scripts/import-modelspend-runner.mjs --verify-only",
    "validate": "bash scripts/validate.sh",
    "test": "bash scripts/test-imported-runner.sh",
    "queue:triage": "node scripts/ops/agent-runner-queue-triage-command.mjs",
    "queue:triage:prompt": "node scripts/ops/agent-runner-queue-triage-command.mjs --format openai",
    "queue:triage:shadow": "node scripts/ops/agent-runner-queue-triage-shadow-command.mjs",
    "queue:triage:consume": "node scripts/ops/agent-runner-queue-triage-consume-command.mjs",
    "queue:triage:execute": "node scripts/ops/agent-runner-queue-triage-execute-command.mjs",
    "queue:triage:closed-loop": "node scripts/ops/agent-runner-queue-triage-local-authority.mjs",
    "local:executor:handoff": "node scripts/ops/agent-runner-local-executor-handoff-command.mjs",
    "validation:profile": "node scripts/ops/agent-runner-validation-profile-command.mjs",
    "recovery:model:reconcile": "node scripts/ops/agent-runner-recovery-model-reconcile-command.mjs",
    "pr:publish": "node scripts/ops/agent-runner-pr-publication-command.mjs",
    "pr:controller": "node scripts/ops/agent-runner-pr-controller-command.mjs",
    "merge:execute": "node scripts/ops/agent-runner-merge-transaction-command.mjs",
    "reconcile:issue": "node scripts/ops/agent-runner-issue-reconciliation-command.mjs",
    "reconcile:attention": "node scripts/ops/agent-runner-attention-reconcile-command.mjs",
    "scheduler:reentry": "node scripts/ops/agent-runner-scheduler-reentry-command.mjs",
    "management:status": "node scripts/ops/agent-runner-management-control-command.mjs status",
    "management:mode": "node scripts/ops/agent-runner-management-control-command.mjs mode",
    "management:fence": "node scripts/ops/agent-runner-management-control-command.mjs fence",
    "management:recover": "node scripts/ops/agent-runner-management-control-command.mjs recover",
    "management:field-acceptance": "node scripts/ops/agent-runner-management-control-command.mjs field-acceptance",
    "management:cutover": "node scripts/ops/agent-runner-management-control-command.mjs cutover"
  }
}
