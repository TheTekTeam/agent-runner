[Unit]
Description=Agent Runner GitHub polling, CI settlement and bounded queue-triage cycle
Documentation=https://github.com/TheTekTeam/agent-runner/blob/main/docs/ops/AGENT-RUNNER-QUEUE-TRIAGE.md
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=%h/.config/agent-runner/event-polling.env
EnvironmentFile=-%h/.config/agent-runner/queue-triage-authority.env
ExecStart=/usr/bin/env node ${AGENT_RUNNER_HOME}/scripts/ops/agent-runner-queue-triage-local-authority.mjs --bootstrap-lookback-ms 86400000 --batch-limit 25 --execute
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/agent-runner
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
RestrictRealtime=true
UMask=0077
TimeoutStartSec=5min

[Install]
WantedBy=default.target
