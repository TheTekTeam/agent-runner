[Unit]
Description=Agent Runner authenticated control dashboard
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=@@CHECKOUT@@
Environment=NODE_OPTIONS=--jitless
ExecStart=@@NODE@@ --jitless @@SERVER@@ --port @@PORT@@
Restart=on-failure
RestartSec=5s
TimeoutStartSec=20s
TimeoutStopSec=15s
TasksMax=64
MemoryMax=384M
OOMPolicy=stop
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/.local/state/agent-runner
ReadWritePaths=%h/.config/agent-runner
ReadWritePaths=%h/.local/state/agent-runner/secrets
ReadWritePaths=%h/.local/state/agent-runner/control-audit.jsonl
RestrictAddressFamilies=AF_UNIX AF_INET
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
UMask=0077

[Install]
WantedBy=default.target
