[Unit]
Description=Agent Runner signed GitHub webhook ingress transport
Documentation=https://github.com/TheTekTeam/agent-runner/blob/main/docs/ops/AGENT-RUNNER-EVENT-TRANSPORT.md
Requires=agent-runner-event-ingress.socket
After=agent-runner-event-ingress.socket

[Service]
Type=simple
EnvironmentFile=%h/.config/agent-runner/event-ingress-transport.env
ExecStart=/usr/bin/env node ${AGENT_RUNNER_HOME}/scripts/ops/agent-runner-event-transport.mjs --listen-fd 3
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=%h/.config/agent-runner
ReadWritePaths=%h/.local/state/agent-runner
RestrictAddressFamilies=AF_INET
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
# This is a systemd --user service. The user manager and its children already
# run without effective capabilities. Do not use directives that request an
# explicit or implicit capability-bounding transition: on this Dell they fail
# before ExecStart with status 218/CAPABILITIES. NoNewPrivileges and the
# loopback-only inherited socket preserve the relevant privilege boundary.
UMask=0077
TimeoutStartSec=30s
TimeoutStopSec=15s

[Install]
WantedBy=default.target
